//-//////////////////////////////////////////////////////
//-                 INCLUDES/EXTENDS
//-//////////////////////////////////////////////////////
extends ../base

//-//////////////////////////////////////////////////////
//-                   MAIN CONTENT
//-//////////////////////////////////////////////////////
block content 
  main#main.main.privacy 
    h1.heading.heading__primary.privacy__heading-primary Política de privacidad

    //- ONE LINER
    section.privacy__short
      h2.heading.heading__secondary.privacy__heading-secondary La versión corta
      p.privacy__short-text Quetre no recoge ningún dato que permita identificarte.

    //- EXPLAINER
    section.faqs.privacy__long
      h2.heading.heading__secondary.privacy__heading-secondary La versión larga
      .faqs__list
        details.faqs__faq
          summary.faqs__question Datos que Quetre recoge activamente
            svg.faqs__icon: use(href='/misc/sprite.svg#icon-open')
          p.faqs__answer Ninguno.
        details.faqs__faq
          summary.faqs__question Datos que Quetre recoge de forma pasiva
            svg.faqs__icon: use(href='/misc/sprite.svg#icon-open')
          p.faqs__answer Cada vez que llegas a una página de error, se registra un objeto de error en la consola del servidor. Ese objeto contiene la URL del recurso al que intentabas acceder y la traza de la pila habitual. Nada más.
        details.faqs__faq
          summary.faqs__question Datos guardados localmente en tu navegador
            svg.faqs__icon: use(href='/misc/sprite.svg#icon-open')
          p.faqs__answer Se guarda una clave llamada «theme» en el almacenamiento local de tu navegador para recordar tu preferencia de tema, si es que cambias el que viene por defecto. Para evitarlo, desactiva JavaScript o el almacenamiento local para Quetre.