//-//////////////////////////////////////////////////////
//-                 INCLUDES/EXTENDS
//-//////////////////////////////////////////////////////
extends ../base

//-//////////////////////////////////////////////////////
//-                SECONDARY CONTENT
//-//////////////////////////////////////////////////////
block header__nav
  nav.header__nav-box(aria-label='Índice de contenidos'): ul.header__nav 
    li.header__nav-item
      a.header__link.header__nav-link(href="#features") Mejoras
    li.header__nav-item
      a.header__link.header__nav-link(href="https://github.com/darlopvil/quetre-fork") Código fuente

block header__info
  .header__info 
    h1.heading.heading__primary.header__hero Un frontend libre para Quora
    a.header__link.header__down(href='#features', aria-label='Ir a la sección de mejoras'): svg.icon.icon__down: use(href='/misc/sprite.svg#icon-down')

block prepend footer
  p.footer__logo Quetre

//-//////////////////////////////////////////////////////
//-                   MAIN CONTENT
//-//////////////////////////////////////////////////////
block content 
  main#main.main.about
    //- AVISO
    section.about__contact
      h2.heading.heading__secondary.about__heading-secondary Fork personal
      p.about__contact-text Esto es un fork de uso estrictamente privado. No está pensado para terceros, no se ofrece como servicio y no se aceptan contribuciones. El código está publicado únicamente como respaldo y para cumplir la licencia:&nbsp;
        a.about__link(href='https://github.com/darlopvil/quetre-fork') github.com/darlopvil/quetre-fork
        |.

    //- MEJORAS
    section.about__features.features#features
      h2.heading.heading__secondary.about__heading-secondary.features__heading Mejoras sobre el proyecto original
      .features__list 
        .features__feature 
          svg.features__feature-icon: use(href='/misc/sprite.svg#icon-spy')
          h3.heading.heading__tertiary.features__feature-heading Acceso restaurado
          p.features__feature-text El proyecto original dejó de funcionar cuando Quora empezó a exigir un reto anti-bot. Aquí el reto se resuelve con un navegador sin interfaz únicamente cuando caduca el permiso, y el resto de peticiones las sirve un cliente HTTP normal.
        .features__feature 
          svg.features__feature-icon: use(href='/misc/sprite.svg#icon-search')
          h3.heading.heading__tertiary.features__feature-heading Búsqueda recuperada
          p.features__feature-text El proyecto original la eliminó en 2024. Aquí funciona a través de la API interna de Quora, con filtros por tipo y por fecha.
        .features__feature 
          svg.features__feature-icon: use(href='/misc/sprite.svg#icon-clock')
          h3.heading.heading__tertiary.features__feature-heading Archivo permanente
          p.features__feature-text Todo lo consultado se guarda en disco de forma indefinida. Si Quora deja de responder, el contenido se sigue sirviendo indicando la fecha de la copia.
        .features__feature 
          svg.features__feature-icon: use(href='/misc/sprite.svg#icon-bolt')
          h3.heading.heading__tertiary.features__feature-heading Caché con rescate
          p.features__feature-text Dos niveles de caché con frescura y retención separadas. Una copia caducada es preferible a un error.
        .features__feature 
          svg.features__feature-icon: use(href='/misc/sprite.svg#icon-danger')
          h3.heading.heading__tertiary.features__feature-heading Errores diagnosticables
          p.features__feature-text Cada fallo se registra con su causa concreta en lugar de agrupar todo bajo el mismo mensaje genérico.
        .features__feature 
          svg.features__feature-icon: use(href='/misc/sprite.svg#icon-pen')
          h3.heading.heading__tertiary.features__feature-heading Respuestas publicadas
          p.features__feature-text Nueva vista con las respuestas que un autor ha publicado en otros medios, accesible desde su perfil.
        .features__feature 
          svg.features__feature-icon: use(href='/misc/sprite.svg#icon-question')
          h3.heading.heading__tertiary.features__feature-heading Respuestas ajenas señaladas
          p.features__feature-text Quora mezcla en el hilo respuestas que en realidad son a otras preguntas. Aquí quedan marcadas para no confundirlas.
        .features__feature 
          svg.features__feature-icon: use(href='/misc/sprite.svg#icon-palette')
          h3.heading.heading__tertiary.features__feature-heading Interfaz en español
          p.features__feature-text Toda la interfaz traducida, incluidos los textos de accesibilidad.

    //- ORIGEN
    section.about__contact#contact
      h2.heading.heading__secondary.about__heading-secondary Origen
      p.about__contact-text Versión modificada de&nbsp;
        a.about__link(href='https://github.com/zyachel/quetre') Quetre
        |, creado por zyachel y publicado bajo licencia AGPL-3.0.