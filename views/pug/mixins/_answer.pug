//-//////////////////////////////////////////////////////
//-                 INCLUDES/EXTENDS
//-//////////////////////////////////////////////////////
include _formatText
include _metadata
include _utils

//-//////////////////////////////////////////////////////
//-                 MAIN CONTENT
//-//////////////////////////////////////////////////////
mixin addAnswer(answer, includeQuestion=false)
  article.answer
    //- ABOUT AUTHOR
    .metadata-primary
      p.metadata-primary__heading
        if answer.author.isAnon
          span Anónimo
        else
          a.link.metadata-primary__link(href=answer.author.url)= answer.author.name
        if answer.author.isVerified
          svg.icon.metadata-primary__icon
            title verified
            use(href='/misc/sprite.svg#icon-verified')
      +proxifyImg(answer.author.image)(class='metadata-primary__image', alt='', aria-hidden='true')
      p.metadata-primary__misc(aria-label=`Credenciales de ${answer.author.name}`)= answer.author.credential || ''

    //- ORIGINAL QUESTION
    if includeQuestion
      p.answer__question.heading.heading__tertiary
        span Respuesta a&nbsp;
        a.answer__link.answers__link(href=answer.question.url)
          +spansChecker(answer.question.text[0].spans)
    else if answer.originalQuestion && !answer.answersThisQuestion
      p.answer__question.answer__question--related.heading.heading__tertiary
        svg.icon.answer__question-icon(aria-hidden='true'): use(href='/misc/sprite.svg#icon-danger')
        span Respuesta a otra pregunta:&nbsp;
        a.answer__link.answers__link(href=answer.originalQuestion.url)
          +spansChecker(answer.originalQuestion.text[0].spans)

    //- ANSWER
    section.answer__text.text__container
      +formatText(answer.text)
      //- for quora plus answers. since quora only shows half answer, we gotta warn viewer.
      unless answer.isViewable
        p.answer__unviewable
          svg.icon.answer__icon: use(href='/misc/sprite.svg#icon-danger')
          | Esta es una respuesta de Quora Plus, así que no se puede ver completa.

    //- ANSWER METADATA
    section.answer__metadata-secondary.metadata-secondary
      +addMetadataSecondary('clock', 'Respondida', answer.creationTime, 'date')
      if answer.updatedTime
        +addMetadataSecondary('clock-edit', 'Actualizada', answer.updatedTime, 'date')
      +addMetadataSecondary('eye', 'Vistas', answer.numViews)
      +addMetadataSecondary('arrow-up', 'Votos', answer.numUpvotes)
      +addMetadataSecondary('comments', 'Comentarios', answer.numComments)
      +addMetadataSecondary('share', 'Compartidos', answer.numShares)
