footer.footer(class=`${meta.title ==='Acerca de' ? 'footer__about' : ''}`)
  block footer

    //- EXTRA STUFF GOES HERE IF THE PAGE IS ABOUT PAGE

    //- NAVIGATION
    nav.footer__nav-box(aria-label='Navegación principal')
      ul.footer__nav 
        - if (meta.title !=='Acerca de') 
          li.footer__nav-item: a.footer__nav-link.footer__link(href="/about") Acerca de
        li.footer__nav-item: a.footer__nav-link.footer__link(href="/search") Búsqueda
        li.footer__nav-item: a.footer__nav-link.footer__link(href="https://github.com/darlopvil/quetre-fork") Código fuente
        li.footer__nav-item: a.footer__nav-link.footer__link(href="/privacy") Privacidad
        li.footer__nav-item: a.footer__nav-link.footer__link(href="#") Volver arriba 

    //- LICENSE
    em.footer__license Quetre no aloja ningún contenido. Todo el contenido es de Quora. Quora es una marca registrada de Quora Inc.