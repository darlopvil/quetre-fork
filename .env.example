## if set to development, will briefly log every request
NODE_ENV=production

### optional properties. default shown. enable by removing # in front of them.
## if using docker compose, make sure the port there is also the same as that in here.
# PORT=3000
#
## duration for which static files' cached copies are valid in the browser(eg: 1m, 3600, '2 days')
# CACHE_PERIOD=1y
#
## user agent and accept header that quora will see.
## NOTA: hacia Quora el User-Agent lo pone curl-impersonate segun el fingerprint;
## este UA solo lo usa el proxy de imagenes.
# USER_AGENT='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36'
# ACCEPT='text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'
#
### transporte hacia Quora (curl-impersonate)
## perfil de navegador que se imita. Cloudflare deja de aceptar los antiguos:
## si aparece el error de fingerprint rechazado, subir la imagen de
## curl-impersonate en el Dockerfile y poner aqui el perfil mas reciente.
# CURL_IMPERSONATE=chrome150
## ruta del binario dentro del contenedor
# CURL_IMPERSONATE_BIN=curl-impersonate
## tiempo maximo por peticion, en segundos
# UPSTREAM_TIMEOUT=30
#
## upstream base url. only change it for testing (e.g. pointing to an
## unreachable host to verify the disk archive fallback).
# QUORA_BASE_URL=https://www.quora.com

### request pacing
## minimum gap between upstream requests in ms, with +-40% jitter. 0 disables the queue.
# MIN_REQUEST_INTERVAL=2000
#
## cooldown when rate-limited from upstream in milliseconds
# RATE_LIMIT_COOLDOWN=7200000 # 2 hours

### caching.
# REDIS_URL= #redis://localhost:6379
## freshness: how long an entry is considered current, in seconds
# REDIS_TTL=86400 # 24 hours
## retention: how long the entry survives in redis once stale, for rescues
# REDIS_HARD_TTL=2592000 # 30 days

### permanent disk archive
## directory for the parsed-page archive. empty string disables it.
# STORE_DIR=/app/store

### for specific use-cases.
#
## add any value here (e.g.: 1, true, 'por favor') if you're using any service where http is the preferred method(e.g.: tor, i2p). else leave it blank
# NO_UPGRADE=